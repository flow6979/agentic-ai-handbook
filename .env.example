# Copy to .env and fill ONE provider. Format: provider:model
# Comma = fallback chain (pehla fail hua to agla).
LLM_MODEL=groq:llama-3.3-70b-versatile
# LLM_MODEL=gemini:gemini-3.8-flash
# LLM_MODEL=openai:gpt-4o-mini
# LLM_MODEL=anthropic:claude-sonnet-5
# LLM_MODEL=ollama:llama3.1            # local, free, no key (install ollama first)
# LLM_MODEL=groq:llama-3.3-70b-versatile,ollama:llama3.1

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Embeddings for RAG: "local" = offline hashing (no key), ya real model
EMBED_MODEL=local
# EMBED_MODEL=gemini:text-embedding-004
# EMBED_MODEL=openai:text-embedding-3-small
# EMBED_MODEL=ollama:nomic-embed-text

# Optional web search providers (03-web-agents). Bina key ke DuckDuckGo use hota hai.
TAVILY_API_KEY=

# 0 = quiet, 1 = har step print
AGENT_VERBOSE=1
# AGENT_TRACE_FILE=traces.jsonl
